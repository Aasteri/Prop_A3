// Propa3 — MySQL schema (local: prop_a3)
// Full MVP schema: see planning/MVP_INTERNAL.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Auth & org ─────────────────────────────────────────────────────────────

enum UserRole {
  CEO
  PROJECT_MANAGER
  FOREMAN
  ENGINEER
  ARCHITECT
  STORE_MANAGER
  FINANCE
  SALES
  CLIENT
  ADMIN
  ARTISAN
  MARKETPLACE_SEEKER
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  phone         String?
  role          UserRole @default(SALES)
  primarySiteId String?  @map("primary_site_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  primarySite       Site?                @relation("PrimarySiteUsers", fields: [primarySiteId], references: [id])
  siteAssignments   UserSiteAssignment[]
  submittedLogs     DailySiteLog[]       @relation("LogSubmittedBy")
  approvedLogs      DailySiteLog[]       @relation("LogApprovedBy")
  managedProjects   Project[]            @relation("ProjectManager")
  originatedChanges ProjectChangeLog[]   @relation("ChangeOriginator")
  revisedChanges    ProjectChangeLog[]   @relation("ChangeRevisedBy")
  approvedChanges   ProjectChangeLog[]   @relation("ChangeApprovedBy")
  requestedMaterials MaterialRequest[]   @relation("MaterialRequestedBy")
  approvedMaterials  MaterialRequest[]   @relation("MaterialApprovedBy")
  issuedMaterials    MaterialRequest[]   @relation("MaterialIssuedBy")
  createdInvoices    Invoice[]            @relation("InvoiceCreatedBy")
  uploadedPayments   Payment[]            @relation("PaymentUploadedBy")
  verifiedPayments   Payment[]            @relation("PaymentVerifiedBy")
  certifiedMilestones Milestone[]         @relation("MilestoneCertifiedBy")
  createdApplications TenantApplication[] @relation("ApplicationCreatedBy")
  reviewedApplications TenantApplication[] @relation("ApplicationReviewedBy")
  tenantEvaluations    TenantEvaluation[]  @relation("TenantEvaluationBy")
  assignedLeads       Lead[]              @relation("LeadAssignedTo")
  createdLeads        Lead[]              @relation("LeadCreatedBy")
  clientProfile       Client?             @relation("ClientPortalUser")
  notifications       Notification[]
  reportedHseIncidents HseIncident[]      @relation("HseReportedBy")
  uploadedDocuments    Document[]          @relation("DocumentUploadedBy")
  auditEvents          AuditEvent[]        @relation("AuditActor")
  professionalLicences ProfessionalLicence[]
  passwordResetTokens PasswordResetToken[]
  ethicsAcknowledgements EthicsAcknowledgement[]
  moneyAttributions    MoneyAttribution[] @relation("MoneyAttributionEarner")
  artisanProfile       ArtisanProfile?
  marketplaceJobs      MarketplaceJob[]          @relation("MarketplaceJobSeeker")
  marketplaceQuotes    MarketplaceQuote[]        @relation("MarketplaceQuoteArtisanUser")
  chatMessages         ChatMessage[]             @relation("ChatMessageSender")
  marketplacePayments  MarketplaceEscrowPayment[] @relation("MarketplacePaymentPayer")

  @@map("users")
}

enum LicenceType {
  COREN
}

model ProfessionalLicence {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  licenceType   LicenceType @default(COREN) @map("licence_type")
  licenceNumber String      @map("licence_number")
  holderName    String?     @map("holder_name")
  expiresAt     DateTime    @map("expires_at") @db.Date
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, licenceType])
  @@map("professional_licences")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model UserSiteAssignment {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  siteId    String   @map("site_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@map("user_site_assignments")
}

model Site {
  id        String   @id @default(cuid())
  code      String   @unique // JKW, MPP, GZ2, GZ3
  name      String
  location  String?
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects        Project[]
  primaryUsers    User[]               @relation("PrimarySiteUsers")
  userAssignments UserSiteAssignment[]
  dailyLogs       DailySiteLog[]
  changeLogs      ProjectChangeLog[]
  materialRequests MaterialRequest[]
  hseIncidents     HseIncident[]

  @@map("sites")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETE
}

/// PM process group — tracks where the project sits in Initiate→Close
enum ProjectProcessGroup {
  INITIATE
  PLAN
  EXECUTE
  MONITOR
  CLOSE
}

model Project {
  id              String        @id @default(cuid())
  siteId          String        @map("site_id")
  projectManagerId String?      @map("project_manager_id")
  name            String
  projectNumber   String?       @map("project_number")
  location        String?
  contractRef     String?       @map("contract_ref")
  status          ProjectStatus @default(PLANNING)
  processGroup    ProjectProcessGroup @default(INITIATE) @map("process_group")
  /// Numeric budget for finance reports (optional; charter.budgetRange remains narrative)
  budgetAmount    Decimal?      @map("budget_amount") @db.Decimal(14, 2)
  fcdaPermitUrl   String?       @map("fcda_permit_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  site           Site           @relation(fields: [siteId], references: [id])
  projectManager User?          @relation("ProjectManager", fields: [projectManagerId], references: [id])
  milestones     Milestone[]
  dailyLogs      DailySiteLog[]
  changeLogs     ProjectChangeLog[]
  materialRequests MaterialRequest[]
  invoices       Invoice[]
  clientProjects ClientProject[]
  hseIncidents   HseIncident[]
  worksContracts WorksContract[]
  inspections    ProjectInspection[]
  closeouts      ProjectCloseout[]
  instalmentPlans PurchaserInstalmentPlan[]
  charter        ProjectCharter?
  kickoffs       ProjectKickoff[]
  retrospectives ProjectRetrospective[]
  ivcs           InterimValuationCertificate[]
  workTasks      WorkScheduleTask[]
  labourSchedules LabourSchedule[]
  progressReports ProgressReport[]
  planningCycles PlanningCycle[]
  workforceEntries WorkforceEntry[]
  qcPlans          QcPlan[]
  feasibility      ProjectFeasibility?
  stakeholders     ProjectStakeholder[]

  @@map("projects")
}

enum ProjectCloseoutStatus {
  DRAFT
  ISSUED
  ACKNOWLEDGED
}

/// Doc 7 / FORM_CLOSEOUT_REPORT — Guzape closeout schema (EXTRACTED)
model ProjectCloseout {
  id                   String                @id @default(cuid())
  number               String                @unique
  projectId            String                @map("project_id")
  developerName        String                @map("developer_name")
  clientName           String                @map("client_name")
  durationStart        DateTime?             @map("duration_start") @db.Date
  durationEnd          DateTime?             @map("duration_end") @db.Date
  executiveSummary     String                @map("executive_summary") @db.Text
  /// [{ "zone": "Basement", "items": ["Cinema", ...] }, ...]
  accomplishmentsJson  Json                  @map("accomplishments_json")
  openItems            String?               @map("open_items") @db.Text
  overBudget           Boolean               @default(false) @map("over_budget")
  onSchedule           Boolean               @default(true) @map("on_schedule")
  preparedBy           String?               @map("prepared_by")
  status               ProjectCloseoutStatus @default(DRAFT)
  issuedAt             DateTime?             @map("issued_at")
  clientAcknowledgedAt DateTime?             @map("client_acknowledged_at")
  clientAcknowledgedBy String?               @map("client_acknowledged_by")
  notes                String?               @db.Text
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("project_closeouts")
}

enum CharterStatus {
  DRAFT
  IN_REVIEW
  APPROVED
}

/// Doc 1 / FORM_PROJECT_CHARTER — initiation authority (EXTRACTED Jikwoyi schema)
model ProjectCharter {
  id                   String        @id @default(cuid())
  number               String        @unique
  projectId            String        @unique @map("project_id")
  title                String
  executiveSummary     String        @map("executive_summary") @db.Text
  goalsJson            Json          @map("goals_json")
  deliverablesJson     Json          @map("deliverables_json")
  businessCase         String?       @map("business_case") @db.Text
  benefits             String?       @db.Text
  costs                String?       @db.Text
  budgetRange          String?       @map("budget_range")
  timeline             String?
  risksJson            Json?         @map("risks_json")
  scopeInJson          Json?         @map("scope_in_json")
  scopeOutJson         Json?         @map("scope_out_json")
  teamJson             Json?         @map("team_json")
  successCriteriaJson  Json?         @map("success_criteria_json")
  status               CharterStatus @default(DRAFT)
  preparedBy           String?       @map("prepared_by")
  companySignedAt      DateTime?     @map("company_signed_at")
  companySignedBy      String?       @map("company_signed_by")
  clientSignedAt       DateTime?     @map("client_signed_at")
  clientSignedBy       String?       @map("client_signed_by")
  approvedAt           DateTime?     @map("approved_at")
  notes                String?       @db.Text
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_charters")
}

enum KickoffStatus {
  DRAFT
  PUBLISHED
}

/// Doc 2 / FORM_KICKOFF_MEETING
model ProjectKickoff {
  id                 String        @id @default(cuid())
  number             String        @unique
  projectId          String        @map("project_id")
  meetingAt          DateTime      @map("meeting_at")
  location           String?
  projectManagerName String?       @map("project_manager_name")
  preparedBy         String?       @map("prepared_by")
  attendeesJson      Json          @map("attendees_json")
  agendaJson         Json          @map("agenda_json")
  actionsJson        Json          @map("actions_json")
  status             KickoffStatus @default(DRAFT)
  publishedAt        DateTime?     @map("published_at")
  notes              String?       @db.Text
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("project_kickoffs")
}

enum RetrospectiveStatus {
  DRAFT
  PUBLISHED
}

/// Doc 8 / FORM_RETROSPECTIVE — lessons learned + optional client testimonial (US-CLOSE-07/08)
model ProjectRetrospective {
  id                   String              @id @default(cuid())
  number               String              @unique
  projectId            String              @map("project_id")
  heldAt               DateTime?           @map("held_at") @db.Date
  ownerName            String?             @map("owner_name")
  collaborators        String?             @db.Text
  projectSummary       String              @map("project_summary") @db.Text
  projectStatusNote    String?             @map("project_status_note")
  goalsObjectives      String?             @map("goals_objectives") @db.Text
  durationNote         String?             @map("duration_note")
  teamNote             String?             @map("team_note") @db.Text
  docsLink             String?             @map("docs_link")
  methodology          String?
  resources            String?             @db.Text
  wentWellJson         Json                @map("went_well_json")
  improvementsJson     Json                @map("improvements_json")
  luckyJson            Json                @map("lucky_json")
  /// [{ "action": "...", "type": "tool|process|team", "owner": "...", "links": "..." }]
  actionsJson          Json                @map("actions_json")
  nextSteps            String?             @map("next_steps") @db.Text
  /// [{ "dateAchieved": "...", "milestone": "..." }]
  timelineJson         Json                @map("timeline_json")
  clientTestimonial    String?             @map("client_testimonial") @db.Text
  clientFeedbackAt     DateTime?           @map("client_feedback_at")
  clientFeedbackBy     String?             @map("client_feedback_by")
  status               RetrospectiveStatus @default(DRAFT)
  publishedAt          DateTime?           @map("published_at")
  preparedBy           String?             @map("prepared_by")
  notes                String?             @db.Text
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("project_retrospectives")
}

// ─── Notifications & HSE ────────────────────────────────────────────────────

enum NotificationType {
  DAILY_LOG_SUBMITTED
  DAILY_LOG_MISSING
  MATERIAL_SHORTAGE
  NEGATIVE_MATERIAL_BALANCE
  HSE_INCIDENT_DRAFT
  MATERIAL_REQUEST_PENDING
  PAYMENT_PROOF_UPLOADED
  ISSUE_EQUIPMENT
  ISSUE_WEATHER
  LEAD_INQUIRY
  COREN_LICENCE_EXPIRING
  TENANCY_RENEWAL
  SALES_OFFER_ISSUED
  SALES_OFFER_RESPONDED
  TENANCY_OFFER_ACCEPTED
  DEPOSIT_SETTLEMENT
  LANDLORD_REMITTANCE
  PROJECT_CLOSEOUT
  PURCHASER_INSTALMENT
  PROJECT_CHARTER
  PROJECT_KICKOFF
  PROJECT_RETROSPECTIVE
  PROJECT_IVC
  PROGRESS_REPORT
  PLANNING_CYCLE
  PAYOUT_BATCH
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String           @db.Text
  linkUrl   String?          @map("link_url")
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

enum HseIncidentStatus {
  DRAFT
  OPEN
  INVESTIGATING
  CLOSED
}

model HseIncident {
  id           String            @id @default(cuid())
  siteId       String            @map("site_id")
  projectId    String            @map("project_id")
  dailyLogId   String?           @unique @map("daily_log_id")
  status       HseIncidentStatus @default(DRAFT)
  description  String            @db.Text
  reportedById String?           @map("reported_by_id")
  reportedAt   DateTime          @default(now()) @map("reported_at")
  closedAt     DateTime?         @map("closed_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  site       Site          @relation(fields: [siteId], references: [id])
  project    Project       @relation(fields: [projectId], references: [id])
  dailyLog   DailySiteLog? @relation(fields: [dailyLogId], references: [id])
  reportedBy User?         @relation("HseReportedBy", fields: [reportedById], references: [id])

  @@index([siteId, status])
  @@map("hse_incidents")
}

// ─── Milestones ─────────────────────────────────────────────────────────────

enum MilestoneStage {
  FOUNDATION
  SHELL
  FINISHING
  HANDOVER
}

model Milestone {
  id            String         @id @default(cuid())
  projectId     String         @map("project_id")
  stage         MilestoneStage
  progressPct   Decimal        @default(0) @map("progress_pct") @db.Decimal(5, 2)
  targetDate    DateTime?      @map("target_date") @db.Date
  completedAt   DateTime?      @map("completed_at")
  certifiedById String?        @map("certified_by_id")
  certifiedAt   DateTime?      @map("certified_at")
  notes         String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  certifiedBy User?   @relation("MilestoneCertifiedBy", fields: [certifiedById], references: [id])

  @@unique([projectId, stage])
  @@map("milestones")
}

/// Sheet 1 / FORM_WORK_SCHEDULE — WBS task rows (EXTRACTED Guzape schema)
model WorkScheduleTask {
  id              String    @id @default(cuid())
  projectId       String    @map("project_id")
  wbsNumber       String    @map("wbs_number")
  taskTitle       String    @map("task_title")
  taskOwner       String?   @map("task_owner")
  startDate       DateTime? @map("start_date") @db.Date
  dueDate         DateTime? @map("due_date") @db.Date
  durationDays    Int?      @map("duration_days")
  dailyHours      Decimal?  @map("daily_hours") @db.Decimal(5, 2)
  progressPct     Decimal   @default(0) @map("progress_pct") @db.Decimal(5, 2)
  isPaymentMilestone Boolean @default(false) @map("is_payment_milestone")
  sprintGoal      String?   @map("sprint_goal")
  phaseLabel      String?   @map("phase_label")
  notes           String?   @db.Text
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, wbsNumber])
  @@map("work_schedule_tasks")
}

/// Sheet 5 / FORM_LABOUR_SCHEDULE
model LabourSchedule {
  id              String   @id @default(cuid())
  number          String   @unique
  projectId       String   @map("project_id")
  projectTitle    String?  @map("project_title")
  projectPhase    String?  @map("project_phase")
  projectManager  String?  @map("project_manager")
  sheetNo         String?  @map("sheet_no")
  scheduleDate    DateTime? @map("schedule_date") @db.Date
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lines   LabourScheduleLine[]

  @@index([projectId])
  @@map("labour_schedules")
}

model LabourScheduleLine {
  id              String    @id @default(cuid())
  scheduleId      String    @map("schedule_id")
  sn              Int
  description     String
  teamTrade       String?   @map("team_trade")
  gangLeader      String?   @map("gang_leader")
  gangSize        Int?      @map("gang_size")
  workStart       DateTime? @map("work_start") @db.Date
  workEnd         DateTime? @map("work_end") @db.Date
  costPerUnit     Decimal?  @map("cost_per_unit") @db.Decimal(14, 2)
  costUnit        String?   @map("cost_unit") // DAY | HOUR
  totalAmount     Decimal?  @map("total_amount") @db.Decimal(14, 2)
  supervisedBy    String?   @map("supervised_by")
  remark          String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  schedule LabourSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, sn])
  @@map("labour_schedule_lines")
}

/// Sheet 3 / FORM_PROGRESS_REPORT — Rockvilla-style stakeholder report
model ProgressReport {
  id                 String    @id @default(cuid())
  number             String    @unique
  projectId          String    @map("project_id")
  reportDate         DateTime  @map("report_date") @db.Date
  preparedBy         String?   @map("prepared_by")
  summary            String    @db.Text
  /// [{ "role": "Project Manager", "name": "..." }]
  teamJson           Json      @map("team_json")
  /// [{ "description", "date", "status", "owner", "comments" }]
  completedJson      Json      @map("completed_json")
  upcomingJson       Json      @map("upcoming_json")
  /// [{ "issue", "impact", "action", "owner" }]
  risksJson          Json      @map("risks_json")
  status             String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt        DateTime? @map("published_at")
  notes              String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, reportDate])
  @@map("progress_reports")
}

enum PlanningCycleKind {
  DAILY
  WEEKLY
  MONTHLY
}

/// Doc 3 — Daily / Weekly / Monthly planning rhythm
model PlanningCycle {
  id              String            @id @default(cuid())
  number          String            @unique
  projectId       String            @map("project_id")
  kind            PlanningCycleKind
  periodStart     DateTime          @map("period_start") @db.Date
  periodEnd       DateTime?         @map("period_end") @db.Date
  /// checklist items [{ "item", "done": bool, "notes" }]
  checklistJson   Json              @map("checklist_json")
  targets         String?           @db.Text
  resourcesNote   String?           @map("resources_note") @db.Text
  risksNote       String?           @map("risks_note") @db.Text
  lookaheadNote   String?           @map("lookahead_note") @db.Text
  cashflowNote    String?           @map("cashflow_note") @db.Text
  preparedBy      String?           @map("prepared_by")
  status          String            @default("DRAFT") // DRAFT | COMPLETE
  completedAt     DateTime?         @map("completed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind, periodStart])
  @@map("planning_cycles")
}

/// Infographic 2 — professional ethics acknowledgement (US-PLAN-24)
model EthicsAcknowledgement {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  version      String   @default("v1")
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")
  notes        String?  @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@map("ethics_acknowledgements")
}

// ─── Site Tracker (Daily Site Log) ──────────────────────────────────────────

enum DailyLogStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ActivityStatus {
  TODO
  ONGOING
  DONE
}

model DailySiteLog {
  id              String         @id @default(cuid())
  projectId       String         @map("project_id")
  siteId          String         @map("site_id")
  date            DateTime       @db.Date
  startTime       String?        @map("start_time")
  endTime         String?        @map("end_time")
  projectName     String         @map("project_name")
  projectLocation String         @map("project_location")
  refCode         String         @unique @map("ref_code")
  status          DailyLogStatus @default(DRAFT)

  skilledWorkers   Int     @default(0) @map("skilled_workers")
  ironBenders      Int     @default(0) @map("iron_benders")
  carpenters       Int     @default(0)
  masons           Int     @default(0)
  plumbers         Int     @default(0)
  electricians     Int     @default(0)
  unskilledWorkers Int     @default(0) @map("unskilled_workers")
  supervisorsCount Int     @default(0) @map("supervisors_count")
  manpowerRemark   String? @map("manpower_remark") @db.Text

  qualitySlumpTest          Boolean @default(false) @map("quality_slump_test")
  qualityCubeCasting        Boolean @default(false) @map("quality_cube_casting")
  qualityReinforcement      Boolean @default(false) @map("quality_reinforcement")
  qualityConcrete           Boolean @default(false) @map("quality_concrete")
  qualityOther              String? @map("quality_other")

  safetyPpeCompliance       Boolean @default(false) @map("safety_ppe_compliance")
  safetyToolboxTalk         Boolean @default(false) @map("safety_toolbox_talk")
  safetyIncidentsNearMisses Boolean @default(false) @map("safety_incidents_near_misses")

  issueMaterialShortage  Boolean @default(false) @map("issue_material_shortage")
  issueEquipmentBreakdown Boolean @default(false) @map("issue_equipment_breakdown")
  issueWeatherDelay      Boolean @default(false) @map("issue_weather_delay")
  issueOther             String? @map("issue_other") @db.Text


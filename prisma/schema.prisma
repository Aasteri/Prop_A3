  grnId       String  @map("grn_id")
  description String
  qtyOrdered  Decimal @map("qty_ordered") @db.Decimal(14, 3)
  qtyReceived Decimal @map("qty_received") @db.Decimal(14, 3)
  qtyAccepted Decimal @map("qty_accepted") @db.Decimal(14, 3)
  qtyRejected Decimal @default(0) @map("qty_rejected") @db.Decimal(14, 3)
  notes       String?

  grn GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_lines")
}

enum SalesInspectionStatus {
  REQUESTED
  SCHEDULED
  COMPLETED_RESPONSE_LOGGED
  FOLLOW_UP
  CANCELLED
}

model SalesInspection {
  id              String                @id @default(cuid())
  number          String                @unique
  leadId          String?               @map("lead_id")
  listingId       String?               @map("listing_id")
  scheduledAt     DateTime?             @map("scheduled_at")
  occurred        Boolean?
  observations    String?               @db.Text
  buyerFeedback   String?               @map("buyer_feedback") @db.Text
  interestLevel   String?               @map("interest_level")
  nextAction      String?               @map("next_action")
  responseAt      DateTime?             @map("response_at")
  status          SalesInspectionStatus @default(REQUESTED)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([listingId])
  @@map("sales_inspections")
}

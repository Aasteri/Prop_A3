  agencySettlementEntityId     String? @map("agency_settlement_entity_id")
  landlordInvoiceId            String? @unique @map("landlord_invoice_id")
  managementInvoiceId          String? @unique @map("management_invoice_id")
  agencyInvoiceId              String? @unique @map("agency_invoice_id")
  status                TenancyOfferStatus @default(DRAFT)
  notes                 String?            @db.Text
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  application TenantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  landlordSettlement   SettlementEntity? @relation("OfferLandlordSettlement", fields: [landlordSettlementEntityId], references: [id])
  managementSettlement SettlementEntity? @relation("OfferManagementSettlement", fields: [managementSettlementEntityId], references: [id])
  agencySettlement     SettlementEntity? @relation("OfferAgencySettlement", fields: [agencySettlementEntityId], references: [id])
  landlordInvoice   Invoice? @relation("OfferLandlordInvoice", fields: [landlordInvoiceId], references: [id])
  managementInvoice Invoice? @relation("OfferManagementInvoice", fields: [managementInvoiceId], references: [id])
  agencyInvoice     Invoice? @relation("OfferAgencyInvoice", fields: [agencyInvoiceId], references: [id])

  @@index([applicationId])
  @@map("tenancy_offers")
}

// ─── Money inflows & attribution (all receipts into the system) ───────────────

enum MoneyChannel {
  BANK_TRANSFER
  PAYSTACK
  MANUAL_OTHER
}

enum EarnerType {
  COMPANY
  INTERNAL_STAFF
  EXTERNAL_AGENT
  ARTISAN
  PROFESSIONAL
  SUBCONTRACTOR
  LANDLORD
  OTHER
}

enum MoneyInflowStatus {
  RECEIVED
  ALLOCATED
  REVERSED
}

model MoneyInflow {
  id              String            @id @default(cuid())
  number          String            @unique
  paymentId       String?           @unique @map("payment_id")
  invoiceId       String?           @map("invoice_id")
  channel         MoneyChannel
  grossAmount     Decimal           @map("gross_amount") @db.Decimal(14, 2)
  receivedAt      DateTime          @map("received_at")
  payerName       String?           @map("payer_name")
  payerReference  String?           @map("payer_reference")
  paystackRef     String?           @map("paystack_ref")
  status          MoneyInflowStatus @default(RECEIVED)
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  payment      Payment?           @relation(fields: [paymentId], references: [id])
  invoice      Invoice?           @relation(fields: [invoiceId], references: [id])
  attributions MoneyAttribution[]

  @@index([receivedAt])
  @@index([status])
  @@map("money_inflows")
}

model MoneyAttribution {
  id           String     @id @default(cuid())
  inflowId     String     @map("inflow_id")
  earnerType   EarnerType @map("earner_type")
  earnerUserId String?    @map("earner_user_id")
  earnerName   String?    @map("earner_name")
  earnerRef    String?    @map("earner_ref")
  sharePct     Decimal?   @map("share_pct") @db.Decimal(5, 2)
  amount       Decimal    @db.Decimal(14, 2)
  /// AGENCY_FEE | MANAGEMENT_FEE | WORKS_FEE | GOODS_MARGIN | ARTISAN_FEE |
  /// PLATFORM_FEE_2_5 | PLATFORM_FEE_10 | COMMISSION | RENT_TO_LANDLORD |
  /// SERVICE_CHARGE | OTHER
  category     String?
  notes        String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  inflow     MoneyInflow @relation(fields: [inflowId], references: [id], onDelete: Cascade)
  earnerUser User?       @relation("MoneyAttributionEarner", fields: [earnerUserId], references: [id])

  @@index([inflowId])
  @@index([earnerType])
  @@map("money_attributions")
}

enum PayoutBatchStatus {
  DRAFT
  PENDING_FINANCE
  PENDING_EXEC
  APPROVED
  PAID
  CANCELLED
}

model PayoutBatch {
  id                 String            @id @default(cuid())
  number             String            @unique
  periodStart        DateTime          @map("period_start") @db.Date
  periodEnd          DateTime          @map("period_end") @db.Date
  status             PayoutBatchStatus @default(DRAFT)
  /// Full worksheet: [{ step, formula, inputs, result, notes }]
  calculationJson    Json              @map("calculation_json")
  grossInflows       Decimal           @map("gross_inflows") @db.Decimal(14, 2)
  totalAttributions  Decimal           @map("total_attributions") @db.Decimal(14, 2)
  totalPayable       Decimal           @map("total_payable") @db.Decimal(14, 2)
  companyRetain      Decimal           @map("company_retain") @db.Decimal(14, 2)
  preparedBy         String?           @map("prepared_by")
  financeReviewedBy  String?           @map("finance_reviewed_by")
  financeReviewedAt  DateTime?         @map("finance_reviewed_at")
  execApprovedBy     String?           @map("exec_approved_by")
  execApprovedAt     DateTime?         @map("exec_approved_at")
  paidAt             DateTime?         @map("paid_at")
  paidBy             String?           @map("paid_by")
  /// Who must act next: FINANCE | CEO_OR_ADMIN | DONE
  nextApproverRole   String?           @map("next_approver_role")
  notes              String?           @db.Text
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  lines PayoutLine[]

  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("payout_batches")
}

model PayoutLine {
  id                   String     @id @default(cuid())
  batchId              String     @map("batch_id")
  earnerType           EarnerType
  earnerName           String     @map("earner_name")
  earnerUserId         String?    @map("earner_user_id")
  earnerRef            String?    @map("earner_ref")
  category             String?
  /// e.g. "10% of rent NGN X" or "2.5% of labour NGN Y"
  calcDetail           String     @map("calc_detail") @db.Text
  sharePct             Decimal?   @map("share_pct") @db.Decimal(7, 4)
  grossBase            Decimal?   @map("gross_base") @db.Decimal(14, 2)
  amount               Decimal    @db.Decimal(14, 2)
  moneyAttributionIds  Json?      @map("money_attribution_ids") // string[]
  sortOrder            Int        @default(0) @map("sort_order")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  batch PayoutBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([earnerType])
  @@map("payout_lines")
}

/// Singleton company-wide fee standards + bank identity (id = "default").
model CompanySettings {
  id String @id @default("default")

  // Fees %
  lettingFeePct                      Decimal @default(10) @map("letting_fee_pct") @db.Decimal(5, 2)
  agencyFeePct                       Decimal @default(10) @map("agency_fee_pct") @db.Decimal(5, 2)
  legalFeePct                        Decimal @default(5) @map("legal_fee_pct") @db.Decimal(5, 2)
  managementFeePct                   Decimal @default(5) @map("management_fee_pct") @db.Decimal(5, 2)
  applicationAgencyLegalPct          Decimal @default(20) @map("application_agency_legal_pct") @db.Decimal(5, 2)
  worksPlatformFeePct                Decimal @default(10) @map("works_platform_fee_pct") @db.Decimal(5, 2)
  worksRetentionPct                  Decimal @default(5) @map("works_retention_pct") @db.Decimal(5, 2)
  servicesPlatformFeePct             Decimal @default(2.5) @map("services_platform_fee_pct") @db.Decimal(5, 2)
  /// Marketplace workmanship fee cut (same for internal & external artisans). Editable in /settings.
  marketplacePlatformFeePct          Decimal @default(2.5) @map("marketplace_platform_fee_pct") @db.Decimal(5, 2)
  cautionDepositPct                  Decimal @default(10) @map("caution_deposit_pct") @db.Decimal(5, 2)
  externalAgentCommissionOfAgencyPct Decimal @default(50) @map("external_agent_commission_of_agency_pct") @db.Decimal(5, 2)

  // Company identity / bank (standards)
  companyLegalName  String @default("TRIPLE A REALTY PROJECTS LTD") @map("company_legal_name")
  bankName          String @default("Tajbank") @map("bank_name")
  bankAccountName   String @default("TRIPLE A REALTY PROJECTS LTD") @map("bank_account_name")
  bankAccountNumber String @default("0013925425") @map("bank_account_number")

  // Standards text
  defaultCurrency String   @default("NGN") @map("default_currency")
  notes           String?  @db.Text
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedBy       String?  @map("updated_by")

  @@map("company_settings")
}

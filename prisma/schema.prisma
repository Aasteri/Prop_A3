  variations       InvoiceVariation[]
  payments         Payment[]
  tenantApplication TenantApplication? @relation("ApplicationAgencyInvoice")
  depositSettlement DepositSettlement? @relation("DepositShortfallInvoice")
  offerLandlordInvoice  TenancyOffer? @relation("OfferLandlordInvoice")
  offerManagementInvoice TenancyOffer? @relation("OfferManagementInvoice")
  offerAgencyInvoice    TenancyOffer? @relation("OfferAgencyInvoice")
  moneyInflows          MoneyInflow[]

  @@index([status, issueDate])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  description String  @db.Text
  quantity    Decimal @db.Decimal(12, 3)
